# Environment variable defaults — copy to .env and adjust before running
# NEVER commit real credentials or secrets.

# ── Capture settings ─────────────────────────────────────────────
# Set CAPTURE_MODE=live on Linux/WSL2 with proper interface
# Use CAPTURE_MODE=pcap_replay (default) on Windows/macOS Docker Desktop
CAPTURE_MODE=pcap_replay
CAPTURE_INTERFACE=br-ot_lab   # Docker bridge interface name (Linux only)
PCAP_FILE=/pcaps/normal_baseline.pcap

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── API ──────────────────────────────────────────────────────────
API_SECRET_KEY=changeme-not-for-production

# ── Lab network ──────────────────────────────────────────────────
LAB_SUBNET=172.20.0.0/24
